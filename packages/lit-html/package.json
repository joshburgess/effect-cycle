{
  "name": "effect-cycle-lit-html",
  "version": "0.1.0",
  "description": "lit-html-backed renderer for effect-cycle",
  "license": "MIT",
  "author": "Josh Burgess",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshburgess/effect-cycle.git",
    "directory": "packages/lit-html"
  },
  "homepage": "https://github.com/joshburgess/effect-cycle/tree/main/packages/lit-html#readme",
  "bugs": {
    "url": "https://github.com/joshburgess/effect-cycle/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && rollup -c rollup.config.mjs && tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "aeon-core": "^0.3.2",
    "aeon-types": "^0.2.0",
    "aeon-scheduler": "^0.3.0",
    "aeon-dom": "^0.3.0",
    "aeon-effect": "^0.2.0"
  },
  "peerDependencies": {
    "effect": "^3.14.0",
    "effect-cycle-core": "workspace:^",
    "effect-cycle-dom": "workspace:^",
    "lit-html": "^3.0.0"
  },
  "devDependencies": {
    "effect": "^3.14.0",
    "effect-cycle-core": "workspace:*",
    "effect-cycle-dom": "workspace:*",
    "lit-html": "^3.0.0",
    "typescript": "^5.7.2"
  }
}
