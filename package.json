{
  "name": "effect-cycle",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "pnpm -r run clean",
    "size": "size-limit",
    "release": "pnpm build && pnpm -r --filter './packages/*' publish --access public"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "size-limit": "^11.2.0",
    "@biomejs/biome": "^1.9.4",
    "@effect/platform": "^0.78.0",
    "@effect/vitest": "^0.29.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@swc/core": "^1.9.0",
    "effect": "^3.14.0",
    "fast-check": "^4.6.0",
    "jsdom": "^25.0.0",
    "rollup": "^4.28.0",
    "rollup-plugin-swc3": "^0.12.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
